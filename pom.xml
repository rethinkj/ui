<?xml version="1.0" encoding="UTF-8"?>
<!-- child.*.inherit.append.path=false: Maven would otherwise append each module's artifactId to the inherited URLs. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.rethinkj.ui</groupId>
  <artifactId>rethinkj-ui-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>rethinkj UI</name>
  <description>Native, GPU-rendered UI framework for Java.</description>
  <url>https://github.com/rethinkj/ui</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/license/mit</url>
    </license>
  </licenses>

  <scm child.scm.connection.inherit.append.path="false"
       child.scm.developerConnection.inherit.append.path="false"
       child.scm.url.inherit.append.path="false">
    <connection>scm:git:https://github.com/rethinkj/ui.git</connection>
    <developerConnection>scm:git:git@github.com:rethinkj/ui.git</developerConnection>
    <url>https://github.com/rethinkj/ui</url>
  </scm>

  <!-- SNAPSHOTs go to the Central Portal's snapshot repository, which the CI deploys to from
       main (.github/workflows/build.yml); there is no release repository yet. -->
  <distributionManagement>
    <snapshotRepository>
      <id>central-snapshots</id>
      <url>https://central.sonatype.com/repository/maven-snapshots/</url>
    </snapshotRepository>
  </distributionManagement>

  <modules>
    <module>core</module>
    <module>kit</module>
    <module>languages</module>
    <module>fonts</module>
    <module>icons</module>
    <module>examples</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <!-- The Javadoc JAR is built only where it is published: -Djavadoc.jar.skip=false. -->
    <javadoc.jar.skip>true</javadoc.jar.skip>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>6.1.3</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <!-- Pinned so that every Maven version builds with the same plugins. -->
    <pluginManagement>
      <plugins>
        <plugin>
          <artifactId>maven-clean-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
        </plugin>
        <plugin>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.1</version>
        </plugin>
        <plugin>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.5.1</version>
        </plugin>
        <plugin>
          <artifactId>maven-install-plugin</artifactId>
          <version>3.2.0</version>
        </plugin>
        <plugin>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>3.2.0</version>
          <configuration>
            <!-- Nothing goes up unless every module of the reactor has built. -->
            <deployAtEnd>true</deployAtEnd>
          </configuration>
        </plugin>
        <plugin>
          <!-- A JAR of the sources beside the classes, for IDEs; core, kit and the languages
               declare it. -->
          <artifactId>maven-source-plugin</artifactId>
          <version>3.4.0</version>
          <executions>
            <execution>
              <id>attach-sources</id>
              <goals>
                <goal>jar-no-fork</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <!-- The API documentation. A JAR of it beside the classes, which Central wants for a
               release; core, kit and the languages declare it. -->
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>3.12.0</version>
          <configuration>
            <!-- A missing comment is not an error; a broken link or bad HTML is. -->
            <doclint>all,-missing</doclint>
            <failOnWarnings>true</failOnWarnings>
            <doctitle>rethinkj UI ${project.version}</doctitle>
            <windowtitle>rethinkj UI ${project.version}</windowtitle>
            <bottom>rethinkj UI, MIT License</bottom>
            <quiet>true</quiet>
          </configuration>
          <executions>
            <execution>
              <id>attach-javadocs</id>
              <!-- Off unless javadoc.jar.skip=false, as the publishing job sets it: verify and
                   install stay as fast as without. -->
              <phase>package</phase>
              <goals>
                <goal>jar</goal>
              </goals>
              <configuration>
                <skip>${javadoc.jar.skip}</skip>
              </configuration>
            </execution>
            <execution>
              <!-- The HTML of core, kit and the languages together, which the site serves at
                   /api/: mvn -P '!natives-linux-x64' -pl core,kit,languages/json -am
                   javadoc:aggregate, into target/reports/apidocs. kit has no module descriptor,
                   and an aggregate cannot mix a named module with unnamed ones: all go on the
                   class path, and without a source path, on which javadoc would find core's
                   module-info.java. -->
              <id>default-cli</id>
              <configuration>
                <legacyMode>true</legacyMode>
                <disableSourcepathUsage>true</disableSourcepathUsage>
                <sourceFileExcludes>
                  <sourceFileExclude>**/module-info.java</sourceFileExclude>
                </sourceFileExcludes>
                <!-- What core's module does not export. -->
                <excludePackageNames>com.rethinkj.ui.gpu:com.rethinkj.ui.natives:com.rethinkj.ui.text.ffi</excludePackageNames>
                <groups>
                  <group>
                    <title>Core</title>
                    <packages>com.rethinkj.ui:com.rethinkj.ui.layout:com.rethinkj.ui.motion:com.rethinkj.ui.render:com.rethinkj.ui.text:com.rethinkj.ui.window</packages>
                  </group>
                  <group>
                    <title>Kit</title>
                    <packages>com.rethinkj.ui.kit</packages>
                  </group>
                  <group>
                    <title>Languages</title>
                    <packages>com.rethinkj.ui.json</packages>
                  </group>
                </groups>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <artifactId>maven-antrun-plugin</artifactId>
          <version>3.2.0</version>
        </plugin>
        <plugin>
          <!-- Runs an example: mvn -pl examples -am compile exec:exec. Elsewhere it skips, and
               wants an executable even then. -->
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>3.6.4</version>
          <configuration>
            <executable>java</executable>
            <skip>true</skip>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <!-- The format of all Java code: mvn spotless:apply writes it, and verify fails on a
             file that is not in it. -->
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <java>
            <includes>
              <include>src/*/java/**/*.java</include>
              <include>scripts/*.java</include>
            </includes>
            <palantirJavaFormat>
              <version>2.103.0</version>
              <!-- Palantir's breaking of call chains with Google's two spaces and 100 columns. -->
              <style>GOOGLE</style>
            </palantirJavaFormat>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Each natives module holds the libraries of one platform and is built only there. The
         profile has the same id in core, which tests with the module. -->
    <profile>
      <id>natives-windows-x64</id>
      <activation>
        <os>
          <family>windows</family>
          <arch>amd64</arch>
        </os>
      </activation>
      <modules>
        <module>natives-windows-x64</module>
      </modules>
    </profile>
    <profile>
      <id>natives-linux-x64</id>
      <activation>
        <os>
          <name>Linux</name>
          <arch>amd64</arch>
        </os>
      </activation>
      <modules>
        <module>natives-linux-x64</module>
      </modules>
    </profile>
  </profiles>
</project>
