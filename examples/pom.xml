<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.rethinkj.ui</groupId>
    <artifactId>rethinkj-ui-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>rethinkj-ui-examples</artifactId>

  <name>rethinkj UI :: Examples</name>
  <description>Small apps that run in a window. Not published.</description>

  <properties>
    <maven.install.skip>true</maven.install.skip>
    <maven.deploy.skip>true</maven.deploy.skip>
    <!-- Arguments for the example, such as a script in place of the window; see AGENTS.md. -->
    <args></args>
    <!-- The JDK that runs Maven runs the example; the file is named with .exe on Windows. -->
    <java.launcher>${java.home}/bin/java</java.launcher>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.rethinkj.ui</groupId>
      <artifactId>rethinkj-ui-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.rethinkj.ui</groupId>
      <artifactId>rethinkj-ui-fonts</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- Runs the example from the folder Maven was started in; see the root POM. -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <skip>false</skip>
          <executable>${java.launcher}</executable>
          <workingDirectory>${session.executionRootDirectory}</workingDirectory>
          <commandlineArgs>--enable-native-access=ALL-UNNAMED -classpath %classpath com.rethinkj.ui.examples.LightSwitch ${args}</commandlineArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>windows</id>
      <activation>
        <os>
          <family>windows</family>
        </os>
      </activation>
      <properties>
        <java.launcher>${java.home}/bin/java.exe</java.launcher>
      </properties>
    </profile>
    <!-- The native libraries of the platform the build runs on, for the window. -->
    <profile>
      <id>natives-windows-x64</id>
      <activation>
        <os>
          <family>windows</family>
          <arch>amd64</arch>
        </os>
      </activation>
      <dependencies>
        <dependency>
          <groupId>com.rethinkj.ui</groupId>
          <artifactId>rethinkj-ui-natives-windows-x64</artifactId>
          <version>${project.version}</version>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>natives-linux-x64</id>
      <activation>
        <os>
          <name>Linux</name>
          <arch>amd64</arch>
        </os>
      </activation>
      <dependencies>
        <dependency>
          <groupId>com.rethinkj.ui</groupId>
          <artifactId>rethinkj-ui-natives-linux-x64</artifactId>
          <version>${project.version}</version>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
