<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.rethinkj.ui</groupId>
    <artifactId>rethinkj-ui-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>rethinkj-ui-icons</artifactId>

  <name>rethinkj UI :: Icons</name>
  <description>Fluent UI System Icons, the default icon font of rethinkj-ui-core.</description>

  <!-- The licence of the font; the text is in the JAR beside it. The font is
       fonts/FluentSystemIcons-Regular.ttf of github.com/microsoft/fluentui-system-icons at the
       tag 1.1.345, unchanged. -->
  <licenses>
    <license>
      <name>MIT License (Fluent UI System Icons)</name>
      <url>https://github.com/microsoft/fluentui-system-icons/blob/1.1.345/LICENSE</url>
    </license>
  </licenses>

  <build>
    <plugins>
      <plugin>
        <!-- No Java code: the JAR holds the font under META-INF/rethinkj-ui/icons/, which
             com.rethinkj.ui.text.Font reads, and its licence. -->
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <!-- The name to pass to add-modules when the JAR is on the module path. -->
              <Automatic-Module-Name>com.rethinkj.ui.icons</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
